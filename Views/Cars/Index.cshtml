@model List<Car_Rental_System.Models.Car>
@{
    ViewData["Title"] = "Available Cars";
}
<div class="container">
    <h1 class="mb-2">Available Cars</h1>
    <p class="text-muted mb-4">
        Select a car below and click Book Car to book it.
    </p>
    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No cars are currently available.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var car in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column p-4">
                            <h4 class="card-title">@car.Name</h4>
                            <h5 class="text-primary mt-2">
                                PKR @car.PricePerDay
                                <small class="text-muted">/day</small>
                            </h5>
                            <div class="mb-3">
                                <span class="badge bg-success">
                                    Available
                                </span>
                            </div>
                            <form asp-controller="Cars"
                                  asp-action="Book"
                                  method="post"
                                  class="mt-auto">
                                <input type="hidden"
                                       name="id"
                                       value="@car.Id" />
                                <button type="submit"
                                        class="btn btn-primary w-100">
                                    Book Car
                                </button>
                            </form>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
